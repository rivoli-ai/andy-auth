{
  "service": {
    "name": "external-chatgpt",
    "displayName": "ChatGPT",
    "description": "Bundled external OAuth consumer registration.",
    "embeddedProxyPrefix": ""
  },
  "auth": {
    "audience": "urn:andy-docs-api",
    "registerAudience": false,
    "webClient": {
      "clientId": "chatgpt",
      "clientType": "public",
      "displayName": "ChatGPT",
      "grantTypes": [
        "authorization_code",
        "refresh_token"
      ],
      "scopes": [
        "email",
        "profile",
        "offline_access",
        "urn:andy-docs-api",
        "urn:andy-code-index-api"
      ],
      "redirectUris": [
        "https://chat.openai.com/api/mcp/auth_callback",
        "https://chatgpt.com/api/mcp/auth_callback",
        "http://127.0.0.1/callback",
        "http://localhost/callback"
      ],
      "useConfiguredMcpResources": true
    }
  }
}
