{
  "service": {
    "name": "external-andy-subscription-cli",
    "displayName": "Andy Subscription CLI",
    "description": "Bundled external OAuth consumer registration.",
    "embeddedProxyPrefix": ""
  },
  "auth": {
    "audience": "urn:andy-subscription-api",
    "registerAudience": false,
    "webClient": {
      "clientId": "andy-subscription-cli",
      "clientType": "public",
      "displayName": "Andy Subscription CLI",
      "grantTypes": [
        "authorization_code",
        "refresh_token"
      ],
      "scopes": [
        "email",
        "profile",
        "roles",
        "offline_access",
        "urn:andy-subscription-api"
      ],
      "redirectUris": [
        "http://127.0.0.1/callback",
        "http://localhost/callback"
      ]
    }
  }
}
