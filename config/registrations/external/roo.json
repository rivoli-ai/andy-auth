{
  "service": {
    "name": "external-roo",
    "displayName": "Roo (VS Code)",
    "description": "Bundled external OAuth consumer registration.",
    "embeddedProxyPrefix": ""
  },
  "auth": {
    "audience": "urn:andy-docs-api",
    "registerAudience": false,
    "webClient": {
      "clientId": "roo",
      "clientType": "public",
      "displayName": "Roo (VS Code)",
      "grantTypes": [
        "authorization_code",
        "refresh_token"
      ],
      "scopes": [
        "email",
        "profile",
        "offline_access",
        "urn:andy-docs-api",
        "urn:andy-code-index-api"
      ],
      "redirectUris": [
        "http://127.0.0.1/callback",
        "http://127.0.0.1:3000/callback",
        "http://127.0.0.1:8080/callback",
        "http://localhost/callback",
        "http://localhost:3000/callback",
        "http://localhost:8080/callback",
        "vscode://roo-cline.roo-cline/callback"
      ]
    }
  }
}
