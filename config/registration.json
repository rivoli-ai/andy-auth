{
  "$schema": "../../andy-service-template/docs/registration.schema.json",
  "service": {
    "name": "andy-auth",
    "displayName": "Andy Auth",
    "description": "OAuth2/OIDC identity provider for the Andy ecosystem — sessions, MFA, OpenIddict-backed authorization server.",
    "embeddedProxyPrefix": "/auth",
    "ports": {
      "dotnetHttps": 5001,
      "dotnetHttp":  5002,
      "dotnetPostgres": 5435,
      "dockerHttps": 7001,
      "dockerHttp":  7002,
      "dockerPostgres": 7435,
      "embeddedProxy": 9100
    }
  },
  "auth": {
    "audience": "urn:andy-auth-api"
  },
  "rbac": {
    "applicationCode": "andy-auth",
    "applicationName": "Andy Auth",
    "description": "OAuth 2.0/OIDC authentication server",
    "resourceTypes": [
      { "code": "user",   "name": "User",          "supportsInstances": true  },
      { "code": "client", "name": "OAuth Client",  "supportsInstances": true  },
      { "code": "scope",  "name": "OAuth Scope",   "supportsInstances": true  },
      { "code": "config", "name": "Configuration", "supportsInstances": false }
    ],
    "roles": [
      { "code": "admin",  "name": "Administrator", "description": "Full access to Andy Auth",           "isSystem": true },
      { "code": "user",   "name": "User",          "description": "Standard Andy Auth user",            "isSystem": true },
      { "code": "viewer", "name": "Viewer",        "description": "Read-only access to Andy Auth data", "isSystem": true }
    ],
    "testUserRole": "admin"
  },
  "settings": {
    "definitions": [
      { "key": "andy.auth.authority",             "displayName": "Auth Authority URL",   "description": "OIDC authority URL",                              "category": "General",  "dataType": "Uri",     "defaultValue": "https://localhost:5001" },
      { "key": "andy.auth.audience",              "displayName": "Auth Audience",        "description": "Expected JWT audience",                           "category": "General",  "dataType": "String",  "defaultValue": "urn:andy-auth-api" },
      { "key": "andy.auth.requireHttpsMetadata",  "displayName": "Require HTTPS Metadata","description": "Require HTTPS for OIDC metadata",                 "category": "Security", "dataType": "Boolean", "defaultValue": false },
      { "key": "andy.auth.tokenLifetimeMinutes",  "displayName": "Token Lifetime",       "description": "Access token lifetime in minutes",                "category": "Security", "dataType": "Integer", "defaultValue": 60 },
      { "key": "sourceControl.github.pat",        "displayName": "GitHub PAT",            "description": "Personal access token for GitHub clone/push/PR operations.",        "category": "SourceControl", "dataType": "Secret", "isSecret": true, "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "sourceControl.azureDevOps.pat",   "displayName": "Azure DevOps PAT",      "description": "Personal access token for Azure DevOps clone/push/PR operations.",  "category": "SourceControl", "dataType": "Secret", "isSecret": true, "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "sourceControl.azureDevOps.org",   "displayName": "Azure DevOps Organisation", "description": "Azure DevOps organisation slug.",                                "category": "SourceControl", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "llm.default",                      "displayName": "Default LLM Provider",  "description": "Conductor unified-settings facade: default chat/completion provider slug.",  "category": "Llm", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "llm.model",                        "displayName": "Default LLM Model",     "description": "Conductor unified-settings facade: default chat/completion model id.",        "category": "Llm", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "llm.baseUrl",                      "displayName": "LLM Base URL",          "description": "Conductor unified-settings facade: override base URL for the default LLM provider.", "category": "Llm", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "llm.providers.ollama.endpoint",    "displayName": "Ollama Endpoint",       "description": "Conductor unified-settings facade: Ollama provider endpoint URL.",            "category": "Llm", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "llm.providers.custom.endpoint",    "displayName": "Custom Provider Endpoint", "description": "Conductor unified-settings facade: custom OpenAI-compatible provider endpoint URL.", "category": "Llm", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "embedding.provider",               "displayName": "Embedding Provider",    "description": "Conductor unified-settings facade: embedding provider slug for semantic search.", "category": "Embedding", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "embedding.apiKey",                 "displayName": "Embedding API Key",     "description": "Conductor unified-settings facade: API key for the embedding provider.",      "category": "Embedding", "dataType": "Secret", "isSecret": true, "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "embedding.model",                  "displayName": "Embedding Model",       "description": "Conductor unified-settings facade: embedding model id.",                       "category": "Embedding", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] },
      { "key": "embedding.baseUrl",                "displayName": "Embedding Base URL",    "description": "Conductor unified-settings facade: override base URL for the embedding provider.", "category": "Embedding", "dataType": "String", "allowedScopes": ["Machine", "Application", "User"] }
    ]
  }
}
