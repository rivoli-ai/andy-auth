@model Andy.Auth.Server.Controllers.AdminAccessViewModel
@{ ViewData["Title"] = "Verify admin access"; }
<section style="max-width: 640px; margin: 0 auto;">
    <h1>Verify admin access</h1>
    <p>Confirm your identity to use administration for the next 15 minutes.</p>
    <div asp-validation-summary="All" role="alert"></div>
    @if (!Model.MfaEnabled)
    {
        <p>Administration requires an authenticator app.</p>
        <a asp-controller="TwoFactor" asp-action="EnableAuthenticator">Set up your authenticator</a>
    }
    else if (Model.RequireSignIn)
    {
        <p>Sign in again with your identity provider before verifying your authenticator.</p>
        <form asp-action="SignInAgain" method="post"><button type="submit" class="btn btn-primary">Sign in again</button></form>
    }
    else
    {
        <form asp-action="Index" method="post">
            <input asp-for="ReturnUrl" type="hidden" />
            @if (Model.RequirePassword)
            {
                <div class="form-group"><label asp-for="Password">Current password</label>
                    <input asp-for="Password" type="password" autocomplete="current-password" required /></div>
            }
            <div class="form-group"><label asp-for="Code">Authenticator code</label>
                <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" required /></div>
            <button type="submit" class="btn btn-primary">Verify admin access</button>
        </form>
    }
</section>
